# ==========================
# Application Environment
# ==========================
APP_ENV=development

# ==========================
# PostgreSQL — Individual Components
# Use these instead of DATABASE_URL to handle special chars in passwords.
# ==========================
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD
DB_HOST=localhost
DB_PORT=5432
DB_NAME=food_rescue

# ==========================
# Frontend CORS
# ==========================
CORS_ORIGINS=http://localhost:5173

# ==========================
# Inventory Settings
# ==========================
EXPIRY_ALERT_DAYS=3